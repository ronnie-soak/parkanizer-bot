# Copy this file to .env and fill in real values before running the bot.
# Those values are intentionally not committed to version control.
PARKANIZER_EMAIL="you@example.com"
PARKANIZER_PASSWORD="your-password"
PARKANIZER_LOCATION="Your parking location name"
PARKANIZER_BOOKING_TAB_LABEL="Book a spot"
PARKANIZER_AVAILABILITY_BUTTON_LABEL="Book now"
PARKANIZER_REFRESH_MILLISECONDS="250"
PARKANIZER_MAX_RUN_SECONDS="600"
PARKANIZER_FUTURE_DAYS_LIMIT="" # Optional: leave empty for unlimited future dates.
PARKANIZER_SESSION_DIR=".parkanizer-browser" # Optional: persistent browser state reused between runs.
